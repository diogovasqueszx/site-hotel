<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>Login | Hotel Royal</title>
    <link rel="stylesheet" href="/css/estilo.css">
</head>

<body>
    <header>
        <div class="wrap top"><a class="brand" href="/site/">Hotel Royal</a>
            <nav aria-label="Navegação principal"><a href="/site/">Início</a><a
                    href="/hospedes/index.html">Hóspedes</a><a href="/quartos/index.html">Quartos</a><a class="active"
                    href="/site/login">Login</a></nav>
        </div>
    </header>
    <main class="wrap">
        <div class="card login">
            <h1>Acesso ao Hotel Royal</h1>
            <p class="muted">A autenticação ainda não está disponível.</p>
            <form action="/site/login" method="post"><label class="field"><span>Usuário</span><input name="usuario"
                        type="text" autocomplete="username" required></label><label
                    class="field"><span>Senha</span><input name="senha" type="password" autocomplete="current-password"
                        required></label><button class="button" type="submit">Entrar</button></form>
        </div>
    </main>
    <footer>Hotel Royal</footer>
</body>

</html>